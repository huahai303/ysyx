missing:~$ ssh myserver 'journalctl -u sshd -b-1 | grep "Disconnected from"' \
  | sed -E 's/.*Disconnected from .* user (.*) [^ ]+ port.*/\1/' \
  | sort | uniq -c \
  | sort -nk1,1 | tail -n10 \
  | awk '{print $2}' | paste -sd,
postgres,mysql,oracle,dell,ubuntu,inspur,test,admin,user,root

# ssh myserver :登录到myserver服务器上执行命令
# journalctl ：用来查看系统日志的命令行工具
# -u sshd :-u代表unit，指查看sshd单元的日志
# -b-1 :-b表示boot启动，-1表示上一次系统启动，指查看上一次系统启动以来的日志
# grep :查找带“Disconnected from”的日志
##################################################################################
# sed -E :sed常用来替换文本，-E使用扩展正则表达式
# s/原内容/替换内容/
# .*Disconnected from :匹配到Disconnected from；.*表示匹配任意字符
# .*user :匹配到user
# (.*) :第一个捕获组
# [^ ]+ :一个或者多个非空格字符
# port.* :匹配port及后面的内容
# \1 :表示第一个捕获组的内容
# (.*)先将user后的所有内容全部装进捕获组，但由于后面的[^ ]+和port.*的命令，又从后向前一个字符一个字符的吐出来，等到[^ ]+和port.*匹配上后，(.*)中只剩下用户名
###################################################################################
# sort :按照字典序排序
# uniq -c :合并相邻且相同的项，-c统计其出现的次数
##################################################################################
# sort -n :按数值大小排序；-k1.1 :以第一列作为排序依据
# tail -n :取排序后的后十位，上一步为升序
##################################################################################
# awk '{print $2}' :只输出第二列
# paste -sd :合并输出，-s把多行合并成一行，-d用，分隔
